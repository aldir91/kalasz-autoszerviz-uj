---
import { site, services } from '../data/site';
const times: string[] = [];
for (let h = 8; h <= 16; h++) { times.push(`${String(h).padStart(2, '0')}:00`, `${String(h).padStart(2, '0')}:30`); }
---
<section class="section" id="idopont">
  <div class="wrap booking">
    <div class="booking__aside">
      <h2>Időpontkérés</h2>
      <p>Töltse ki az űrlapot, és hétköznap munkaidőben visszahívjuk az időpont egyeztetéséhez. Az űrlap beküldése még nem végleges foglalás.</p>
      <p>Sürgős esetben inkább hívjon közvetlenül.</p>
      <a class="btn btn--outline" href={site.phoneHref}>{site.phone}</a>
    </div>
    <form class="form" id="booking-form" data-key={import.meta.env.PUBLIC_WEB3FORMS_KEY} novalidate>
      <div class="field"><label for="f-name">Név *</label><input id="f-name" name="Név" required autocomplete="name" /></div>
      <div class="field"><label for="f-phone">Telefonszám *</label><input id="f-phone" name="Telefonszám" type="tel" required autocomplete="tel" /></div>
      <div class="field field--full"><label for="f-email">E-mail</label><input id="f-email" name="E-mail" type="email" autocomplete="email" /></div>
      <div class="field field--full">
        <label for="f-service">Szolgáltatás *</label>
        <select id="f-service" name="Szolgáltatás" required>
          <option value="">Válasszon…</option>
          {services.map((s) => <option>{s.title}</option>)}
          <option>Egyéb</option>
        </select>
      </div>
      <div class="field"><label for="f-car">Autó típusa</label><input id="f-car" name="Autó típusa" placeholder="pl. Audi A4 2.0 TDI" /></div>
      <div class="field"><label for="f-plate">Rendszám</label><input id="f-plate" name="Rendszám" autocapitalize="characters" /></div>
      <div class="field"><label for="f-date">Kívánt dátum *</label><input id="f-date" name="Kívánt dátum" type="date" required /></div>
      <div class="field">
        <label for="f-time">Kívánt időpont *</label>
        <select id="f-time" name="Kívánt időpont" required><option value="">Válasszon…</option>{times.map((t) => <option>{t}</option>)}</select>
      </div>
      <div class="field field--full"><label for="f-note">Megjegyzés</label><textarea id="f-note" name="Megjegyzés" placeholder="Írja le röviden a hibát vagy a kérést"></textarea></div>
      <input class="hp" type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <label class="consent field--full">
        <input type="checkbox" id="f-consent" required />
        <span>Elolvastam és elfogadom az <a href="/adatkezeles" target="_blank">adatkezelési tájékoztatót</a>. *</span>
      </label>
      <div class="field--full"><button class="btn btn--red" type="submit" id="f-submit">Időpontot kérek</button></div>
      <p class="form__status" id="f-status" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>
<script define:vars={{ phone: site.phone }}>
  const form = document.getElementById('booking-form');
  const status = document.getElementById('f-status');
  const submit = document.getElementById('f-submit');
  const date = document.getElementById('f-date');
  const today = new Date(); today.setMinutes(today.getMinutes() - today.getTimezoneOffset());
  date.min = today.toISOString().slice(0, 10);
  date.addEventListener('change', () => {
    const d = new Date(date.value + 'T12:00:00');
    date.setCustomValidity([0, 6].includes(d.getDay()) ? 'Hétvégén zárva vagyunk, kérjük, válasszon hétköznapot.' : '');
  });
  const say = (msg, cls) => { status.textContent = msg; status.className = 'form__status ' + (cls || ''); };
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;
    const key = form.dataset.key;
    if (!key) { say('Az űrlap még nincs bekötve. Kérjük, hívjon minket: ' + phone, 'err'); return; }
    const data = new FormData(form);
    data.append('access_key', key);
    data.append('subject', 'Új időpontkérés – Kalász Autószerviz');
    data.append('from_name', 'Kalász Autószerviz weboldal');
    submit.disabled = true; say('Küldés…');
    try {
      const res = await fetch('https://api.web3forms.com/submit', { method: 'POST', body: data, headers: { Accept: 'application/json' } });
      const json = await res.json();
      if (!json.success) throw new Error(json.message);
      form.reset();
      say('Köszönjük! Megkaptuk az időpontkérést, hamarosan visszahívjuk.', 'ok');
    } catch (err) {
      say('A küldés nem sikerült. Kérjük, próbálja újra, vagy hívjon minket: ' + phone, 'err');
    } finally { submit.disabled = false; }
  });
</script>
