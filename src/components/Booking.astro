---
import { site, services } from '../data/site';
const times: string[] = [];
for (let h = 8; h <= 16; h++) { times.push(`${String(h).padStart(2, '0')}:00`, `${String(h).padStart(2, '0')}:30`); }
---
<section class="section" id="idopont">
  <div class="wrap booking">
    <div class="booking__aside">
      <h2>Időpontkérés</h2>
      <p>Töltse ki az űrlapot, és hétköznap munkaidőben visszahívjuk az időpont egyeztetéséhez. Az űrlap beküldése még nem végleges foglalás.</p>
      <p>Sürgős esetben inkább hívjon közvetlenül.</p>
      <a class="btn btn--outline" href={site.phoneHref}>{site.phone}</a>
    </div>
    <form class="form" id="booking-form" data-key={import.meta.env.PUBLIC_WEB3FORMS_KEY} novalidate>
      <div class="field"><label for="f-name">Név *</label><input id="f-name" name="Nev" required autocomplete="name" /></div>
      <div class="field"><label for="f-phone">Telefonszám *</label><input id="f-phone" name="Telefonszam" type="tel" required autocomplete="tel" /></div>
      <div class="field field--full"><label for="f-email">E-mail</label><input id="f-email" name="E-mail" type="email" autocomplete="email" /></div>
      <div class="field field--full">
        <label for="f-service">Szolgáltatás *</label>
        <select id="f-service" name="Szolgaltatas" required>
          <option value="">Válasszon…</option>
          {services.map((s) => <option>{s.title}</option>)}
          <option>Egyéb</option>
        </select>
      </div>
      <div class="field"><label for="f-car">Autó típusa</label><input id="f-car" name="Auto tipusa" placeholder="pl. Audi A4 2.0 TDI" /></div>
      <div class="field"><label for="f-plate">Rendszám</label><input id="f-plate" name="Rendszam" autocapitalize="characters" /></div>
      <div class="field"><label for="f-date">Kívánt dátum *</label><input id="f-date" name="Kivant datum" type="date" required /></div>
      <div class="field">
        <label for="f-time">Kívánt időpont *</label>
        <select id="f-time" name="Kivant idopont" required><option value="">Válasszon…</option>{times.map((t) => <option>{t}</option>)}</select>
      </div>
      <div class="field field--full"><label for="f-note">Megjegyzés</label><textarea id="f-note" name="Megjegyzes" placeholder="Írja le röviden a hibát vagy a kérést"></textarea></div>
      <input class="hp" type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <label class="consent field--full">
        <input type="checkbox" id="f-consent" required />
        <span>Elolvastam és elfogadom az <a href="/adatkezeles" target="_blank">adatkezelési tájékoztatót</a>. *</span>
      </label>
      <div class="field--full"><button class="btn btn--red" type="submit" id="f-submit">Időpontot kérek</button></div>
      <p class="form__status" id="f-status" role="status" aria-live="polite"></p>
      <div class="thanks" id="booking-thanks" hidden tabindex="-1" role="status">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
        <h3>Köszönjük, megkaptuk!</h3>
        <p>Hétköznap munkaidőben visszahívjuk az időpont egyeztetéséhez. Ha sürgős, hívjon minket: <a href={site.phoneHref}>{site.phone}</a></p>
        <button class="btn btn--outline" type="button" id="thanks-again">Új kérés küldése</button>
      </div>
    </form>
  </div>
</section>
<script define:vars={{ phone: site.phone }}>
  const form = document.getElementById('booking-form');
  const status = document.getElementById('f-status');
  const submit = document.getElementById('f-submit');
  const date = document.getElementById('f-date');
  const today = new Date(); today.setMinutes(today.getMinutes() - today.getTimezoneOffset());
  date.min = today.toISOString().slice(0, 10);
  date.addEventListener('change', () => {
    const d = new Date(date.value + 'T12:00:00');
    date.setCustomValidity([0, 6].includes(d.getDay()) ? 'Hétvégén zárva vagyunk, kérjük, válasszon hétköznapot.' : '');
  });
  const say = (msg, cls) => { status.textContent = msg; status.className = 'form__status ' + (cls || ''); };
  const thanks = document.getElementById('booking-thanks');
  const showThanks = () => {
    Array.from(form.children).forEach((c) => { if (c !== thanks) c.style.display = 'none'; });
    thanks.hidden = false;
    thanks.focus();
  };
  document.getElementById('thanks-again')?.addEventListener('click', () => {
    thanks.hidden = true;
    Array.from(form.children).forEach((c) => { if (c !== thanks) c.style.display = ''; });
    say('');
  });
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;
    const key = form.dataset.key;
    if (!key) { say('Az űrlap még nincs bekötve. Kérjük, hívjon minket: ' + phone, 'err'); return; }
    const data = new FormData(form);
    data.append('access_key', key);
    data.append('subject', 'Új időpontkérés – Kalász Autószerviz');
    data.append('from_name', 'Kalász Autószerviz weboldal');
    submit.disabled = true; say('Küldés…');
    try {
      const res = await fetch('https://api.web3forms.com/submit', { method: 'POST', body: data, headers: { Accept: 'application/json' } });
      const json = await res.json();
      if (!json.success) throw new Error(json.message);
      form.reset();
      showThanks();
    } catch (err) {
      say('A küldés nem sikerült. Kérjük, próbálja újra, vagy hívjon minket: ' + phone, 'err');
    } finally { submit.disabled = false; }
  });
</script>
<style>
  .thanks {
    grid-column: 1 / -1;
    text-align: center;
    padding: 2.5rem 1.5rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface);
    outline: none;
  }
  .thanks:not([hidden]) {
    display: grid;
    justify-items: center;
    gap: 0.9rem;
    animation: thanks-in 0.35s ease-out;
  }
  .thanks svg {
    width: 4.2rem;
    height: 4.2rem;
    padding: 1rem;
    border-radius: 50%;
    background: var(--red);
    color: #fff;
  }
  .thanks p { color: var(--muted); max-width: 30rem; }
  .thanks p a { color: var(--text); font-weight: 600; }
  @keyframes thanks-in {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .thanks:not([hidden]) { animation: none; }
  }
</style>
