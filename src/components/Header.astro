---
import { site } from '../data/site';
const links = [
  ['Szolgáltatások', '/#szolgaltatasok'],
  ['Rólunk', '/#rolunk'],
  ['Referenciák', '/#referenciak'],
  ['Időpontfoglalás', '/#idopont'],
  ['Kapcsolat', '/#kapcsolat'],
];
---
<header class="header">
  <div class="wrap header__in">
    <a class="brand" href="/" aria-label={`${site.name} – főoldal`}>
      <img src="/logo.svg" alt="" width="46" height="46" />
      <span>{site.name}</span>
    </a>
    <nav class="nav" id="nav" aria-label="Fő menü">
      {links.map(([label, href]) => <a href={href}>{label}</a>)}
      <a class="nav__fb" href={site.facebook} target="_blank" rel="noopener">Facebook</a>
    </nav>
    <div class="tools">
      <a class="icon-btn fb" href={site.facebook} target="_blank" rel="noopener" aria-label="Facebook" title="Facebook">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
      </a>
      <button class="icon-btn theme-toggle" type="button" aria-label="Világos / sötét mód váltása" title="Világos / sötét mód">
        <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      </button>
    </div>
    <button class="icon-btn menu-btn" type="button" aria-label="Menü" aria-expanded="false" aria-controls="nav">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
  </div>
</header>
<style>
  .icon-btn {
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 50%;
    transition: background-color 0.15s;
  }
  .icon-btn:hover { background: rgba(255, 255, 255, 0.2); }
  .icon-btn svg { width: 22px; height: 22px; }
  .header :focus-visible { outline-color: #fff; }
  .tools {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    padding-left: 1.1rem;
    border-left: 1px solid rgba(255, 255, 255, 0.4);
  }
  .nav__fb { display: none; }
  @media (max-width: 960px) {
    .tools { padding-left: 0; border-left: 0; }
    .fb { display: none; }
    .nav__fb { display: block; }
  }
</style>
<script>
  const root = document.documentElement;
  document.querySelector('.theme-toggle')?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch (e) {}
  });
  const btn = document.querySelector('.menu-btn');
  const nav = document.getElementById('nav');
  btn?.addEventListener('click', () => {
    const open = nav?.classList.toggle('is-open');
    btn.setAttribute('aria-expanded', String(!!open));
  });
  nav?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => {
    nav.classList.remove('is-open');
    btn?.setAttribute('aria-expanded', 'false');
  }));
</script>
