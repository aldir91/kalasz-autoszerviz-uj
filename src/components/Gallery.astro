---
import { Image, getImage } from 'astro:assets';

// Tedd a képeket a src/assets/gallery/ mappába (jpg, png, webp) – automatikusan megjelennek.
const modules = import.meta.glob<{ default: ImageMetadata }>('/src/assets/gallery/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG}', { eager: true });
const sources = Object.entries(modules).sort(([a], [b]) => a.localeCompare(b)).map(([, m]) => m.default);
const items = await Promise.all(
  sources.map(async (src) => ({ src, full: (await getImage({ src, width: 1800, format: 'webp' })).src })),
);
const VISIBLE = 6;
---
<section class="section" id="referenciak">
  <div class="wrap">
    <div class="section__head">
      <h2>Pár kép szervizünkből</h2>
      <p>Így dolgozunk: valódi munkák a békési műhelyből.</p>
    </div>
    {items.length === 0 ? (
      <p class="gallery-empty">Még nincs kép. Másold a fotókat a <code>src/assets/gallery/</code> mappába.</p>
    ) : (
      <div class="grid">
        {items.map((it, i) => (
          <button class="tile" type="button" data-full={it.full} hidden={i >= VISIBLE} aria-label="Kép megnyitása nagyban">
            <Image src={it.src} width={720} height={540} fit="cover" alt="Munka a Kalász Autószerviz műhelyében" loading="lazy" format="webp" />
          </button>
        ))}
      </div>
    )}
    {items.length > VISIBLE && (
      <div class="gallery__more"><button class="btn btn--outline" type="button" id="gallery-more">Összes kép ({items.length})</button></div>
    )}
  </div>
</section>
<dialog class="lightbox" id="lightbox" aria-label="Képnézegető">
  <div class="lightbox__in"><img alt="" id="lb-img" /></div>
  <button class="lb-close" type="button" aria-label="Bezárás">×</button>
  <button class="lb-prev" type="button" aria-label="Előző kép">‹</button>
  <button class="lb-next" type="button" aria-label="Következő kép">›</button>
</dialog>
<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.9rem;
  }
  .tile {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    padding: 0;
    border: 0;
    border-radius: 4px;
    overflow: hidden;
    background: var(--surface);
    cursor: zoom-in;
  }
  .tile[hidden] { display: none; }
  .tile :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s;
  }
  .tile:hover :global(img),
  .tile:focus-visible :global(img) { transform: scale(1.05); }
  .tile::after {
    content: '+';
    position: absolute;
    right: 0.7rem;
    bottom: 0.7rem;
    width: 2.4rem;
    height: 2.4rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--red);
    color: #fff;
    font: 700 1.7rem/1 var(--display);
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.2s, transform 0.2s;
  }
  .tile:hover::after,
  .tile:focus-visible::after { opacity: 1; transform: none; }
  @media (max-width: 860px) {
    .grid { grid-template-columns: repeat(2, 1fr); gap: 0.6rem; }
  }
</style>
<script>
  const dlg = document.getElementById('lightbox') as HTMLDialogElement | null;
  const img = document.getElementById('lb-img') as HTMLImageElement | null;
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.tile'));
  let idx = 0;
  const show = (i: number) => {
    if (!img || !buttons.length) return;
    idx = (i + buttons.length) % buttons.length;
    img.src = buttons[idx].dataset.full || '';
  };
  buttons.forEach((b, i) => b.addEventListener('click', () => { show(i); dlg?.showModal(); }));
  dlg?.querySelector('.lb-close')?.addEventListener('click', () => dlg.close());
  dlg?.querySelector('.lb-prev')?.addEventListener('click', () => show(idx - 1));
  dlg?.querySelector('.lb-next')?.addEventListener('click', () => show(idx + 1));
  dlg?.addEventListener('click', (e) => { if (e.target === dlg || (e.target as HTMLElement).classList.contains('lightbox__in')) dlg.close(); });
  dlg?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') show(idx - 1);
    if (e.key === 'ArrowRight') show(idx + 1);
  });
  document.getElementById('gallery-more')?.addEventListener('click', (e) => {
    buttons.forEach((b) => (b.hidden = false));
    (e.currentTarget as HTMLElement).parentElement?.remove();
  });
  // érintőképernyős lapozás
  let x0 = 0;
  dlg?.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
  dlg?.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - x0;
    if (Math.abs(dx) > 50) show(dx > 0 ? idx - 1 : idx + 1);
  });
</script>
